{
  "realm": "hubmi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user" },
      { "name": "admin", "description": "Administrator" },
      { "name": "expert", "description": "Ekspert ROPS: pracownik moderujący zgłoszenia i odpowiadający mieszkańcom" }
    ]
  },
  "defaultRole": { "name": "default-roles-hubmi" },
  "clients": [
    {
      "clientId": "hubmi-app",
      "name": "HubMI app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*",
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:4173/*",
        "http://127.0.0.1:3000/*",
        "io.github.mfabisiak.hubmi:/oauth2redirect"
      ],
      "webOrigins": [
        "*",
        "+",
        "http://localhost:5173",
        "http://localhost:4173",
        "http://localhost:3000",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:4173",
        "http://127.0.0.1:3000"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "id": "c0000000-0000-0000-0000-000000000001",
      "username": "user",
      "email": "user@hubmi.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "user", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "admin",
      "email": "admin@hubmi.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "expert",
      "email": "expert@hubmi.local",
      "firstName": "Anna",
      "lastName": "Nowak",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "expert", "temporary": false }],
      "realmRoles": ["user", "expert"]
    }
  ]
}
