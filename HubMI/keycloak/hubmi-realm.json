{
  "realm": "hubmi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user" },
      { "name": "admin", "description": "Administrator" },
      { "name": "expert", "description": "Expert / mentor" }
    ]
  },
  "defaultRole": { "name": "default-roles-hubmi" },
  "clients": [
    {
      "clientId": "hubmi-app",
      "name": "HubMI app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*",
        "io.github.mfabisiak.hubmi:/oauth2redirect"
      ],
      "webOrigins": ["http://localhost:5173", "http://localhost:4173", "http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "id": "c0000000-0000-0000-0000-000000000001",
      "username": "user",
      "email": "user@hubmi.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "user", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "admin",
      "email": "admin@hubmi.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "expert",
      "email": "expert@hubmi.local",
      "firstName": "Test",
      "lastName": "Expert",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "expert", "temporary": false }],
      "realmRoles": ["user", "expert"]
    }
  ]
}
